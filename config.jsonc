{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii/logo.txt",
    "color": {
      "1": "38;2;245;224;220",
      "2": "38;2;242;205;205",
      "3": "38;2;245;194;231",
      "4": "38;2;250;179;135",
      "5": "38;2;249;226;175",
      "6": "38;2;166;227;161",
      "7": "38;2;148;226;213",
      "8": "38;2;137;220;235",
      "9": "38;2;116;199;236"
    },
    "padding": {
      "top": 0,
      "right": 3
    }
  },
  "display": {
    "separator": " ▸ " // :
  },
  "modules": [
        {
      "type": "custom",
      "format": "\u001b[36m👻 Ghost in the Shell 👻\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;0;255;0m=========================\u001b[0m" // Garis atas warna #00ff00
    },
    "break",
    {
      "type": "os",
      "key": "  ", // Ikon Ubuntu 
      "keyColor": "yellow",
      "format": "Ubuntu 26.04 LTS"
    },
    {
      "type": "kernel",
      "key": "  ", // Ikon Linux
      "keyColor": "white",
      "format": "Linux 5.15.189"
    },
    {
      "type": "memory",
      "key": " 󰍛 ", // Ikon Chip/RAM
      "keyColor": "magenta",
      "format": "{1} / {2}" // Menampilkan Terpakai / Total tanpa persentase
    },
    {
      "type": "packages",
      "key": " 󰏖 ", // Ikon Kardus (Package)
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": " 󰋊 ", // Ikon Hard disk / Storage
      "keyColor": "blue",
      "folders": "/"
    },
    {
      "type": "command",
      "key": " 󰁹 ",
      "keyColor": "green",
      "text": "echo \"$(cat /sys/class/power_supply/battery/capacity)%\""
    },
    {
      "type": "host", // Host biasanya mendeteksi nama Chipset / SoC
      "key": " 󰻠 ", // Ikon Motherboard / Chipset
      "keyColor": "cyan",
      "format": "UMS9230E SOC"
    },
    {
      "type": "cpu",
      "key": "  ", // Ikon Prosesor
      "keyColor": "blue",
      "format": "8 CORES @ 1.82 GHz"
    },
    {
      "type": "uptime",
      "key": " 󰅐 ", // Ikon Jam
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;0;255;0m=========================\u001b[0m" // Garis atas warna #00ff00
    }
  ]
}
